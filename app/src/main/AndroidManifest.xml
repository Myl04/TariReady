<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".TariReadyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.view.SigninActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".auth.view.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".profile.view.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".dashboard.view.DashboardActivity" />

        <activity
            android:name=".dashboard.view.DashboardActivity"
            android:exported="false"
            android:parentActivityName=".auth.view.SigninActivity" />

        <activity
            android:name=".inventory.view.InventoryActivity"
            android:exported="false"
            android:parentActivityName=".dashboard.view.DashboardActivity" />

        <activity
            android:name=".history.view.HistoryActivity"
            android:exported="false"
            android:parentActivityName=".dashboard.view.DashboardActivity" />

        <activity
            android:name=".supply.view.AddSupplyActivity"
            android:exported="false"
            android:parentActivityName=".inventory.view.InventoryActivity" />

        <activity
            android:name=".supply.view.SupplyDetailActivity"
            android:exported="false"
            android:parentActivityName=".inventory.view.InventoryActivity" />

    </application>

</manifest>
